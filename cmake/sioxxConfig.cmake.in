@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@SIOXX_FIND_PRIVATE_LINK_DEPENDENCIES@)
  find_dependency(OpenSSL)
  find_dependency(Threads)
endif()

if(@SIOXX_USE_SYSTEM_JSON@)
  find_dependency(nlohmann_json 3.12.0)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sioxxTargets.cmake")

check_required_components(sioxx)
