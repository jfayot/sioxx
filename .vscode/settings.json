{
  "cmake.configureSettings": {
    "CMAKE_BUILD_TYPE": "Release",
    "SIOXX_BUILD_EXAMPLES": "ON",
    "SIOXX_BUILD_TESTS": "ON"
  },
  "editor.defaultFormatter": "xaver.clang-format",
  "editor.formatOnSave": true,
  "cmake.buildBeforeRun": true,
  "cmake.saveBeforeBuild": true,
  "[cmake]": {
    "editor.defaultFormatter": "cheshirekow.cmake-format",
    "editor.formatOnSave": true
  },
  "cSpell.words": [
    "Asio",
    "BINDIR",
    "cbor",
    "chrono",
    "ctest",
    "DBUILD",
    "DCMAKE",
    "DSIOXX",
    "engineio",
    "INCLUDEDIR",
    "libsioxx",
    "mswsock",
    "nlohmann",
    "sioxx",
    "socketio",
    "SOVERSION",
    "tlsext"
  ],
  "cmakeFormat.args": [
    "--config-file",
    "${workspaceFolder}/.cmake-format"
  ]
}
